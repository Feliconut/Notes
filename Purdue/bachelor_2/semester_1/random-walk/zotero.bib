@article{cernyQuenchedInvariance2020,
  title = {Quenched Invariance Principles for the Maximal Particle in Branching Random Walk in Random Environment and the Parabolic {{Anderson}} Model},
  author = {\v Cern\'y, Ji\v r\'i and Drewitz, Alexander},
  date = {2020-01},
  journaltitle = {The Annals of Probability},
  volume = {48},
  number = {1},
  pages = {94--146},
  publisher = {Institute of Mathematical Statistics},
  issn = {0091-1798, 2168-894X},
  doi = {10.1214/19-AOP1347},
  abstract = {We consider branching random walk in spatial random branching environment (BRWRE) in dimension one, as well as related differential equations: the Fisher--KPP equation with random branching and its linearized version, the parabolic Anderson model (PAM). When the random environment is bounded, we show that after recentering and scaling, the position of the maximal particle of the BRWRE, the front of the solution of the PAM, as well as the front of the solution of the randomized Fisher--KPP equation fulfill quenched invariance principles. In addition, we prove that at time \$t\$ the distance between the median of the maximal particle of the BRWRE and the front of the solution of the PAM is in \$O(\textbackslash ln t)\$. This partially transfers classical results of Bramson (Comm. Pure Appl. Math. 31 (1978) 531--581) to the setting of BRWRE.}
}

@online{cernyTightnessMaximum2024,
  title = {On the Tightness of the Maximum of Branching {{Brownian}} Motion in Random Environment},
  author = {\v Cern\'y, Ji\v r\'i and Drewitz, Alexander and Oswald, Pascal},
  date = {2024-06-24},
  eprint = {2212.12390},
  eprinttype = {arXiv},
  eprintclass = {math},
  doi = {10.48550/arXiv.2212.12390},
  abstract = {We consider one-dimensional branching Brownian motion in spatially random branching environment (BBMRE) and show that for almost every realisation of the environment, the distributions of the maximal particle of the BBMRE re-centred around its median are tight as time evolves. This result is in stark contrast to the fact that the transition fronts in the solution to the randomised Fisher--Kolmogorov--Petrovskii--Piskunov (F-KPP) equation are, in general, not bounded uniformly in time. In particular, this highlights that -- when compared to the settings of homogeneous branching Brownian motion and the F-KPP equation in a homogeneous environment -- the introduction of a random environment leads to a much more intricate behaviour.},
  pubstate = {prepublished}
}

@article{chanRandomWalks2021,
