@article{buraczewskiDerivativeMartingale2021,
  title = {On the {{Derivative Martingale}} in a {{Branching Random Walk}}},
  author = {Buraczewski, Dariusz and Iksanov, Alexander and Mallein, Bastien},
  date = {2021},
  journaltitle = {The Annals of Probability},
  volume = {49},
  number = {3},
  eprint = {27172541},
  eprinttype = {jstor},
  pages = {1164--1204},
  publisher = {Institute of Mathematical Statistics},
  issn = {0091-1798},
  doi = {10.1214/20-AOP1474},
  abstract = {We work under the A\"id\'ekon--Chen conditions which ensure that the derivative martingale in a supercritical branching random walk on the line converges almost surely to a nondegenerate nonnegative random variable that we denote by Z. It is shown that {$\mathbb{E}$}Z {$\mathbb{1}$}\{Z{$\leq$}x\} = log x + o(log x) as x {$\rightarrow$} {$\infty$}. Also, we provide necessary and sufficient conditions under which {$\mathbb{E}$}Z {$\mathbb{1}$}\{Z{$\leq$}x\} = log x + const + o(1) as x {$\rightarrow$} {$\infty$}. This more precise asymptotics is a key tool for proving distributional limit theorems which quantify the rate of convergence of the derivative martingale to its limit Z. The methodological novelty of the present paper is a three terms representation of a subharmonic function of, at most, linear growth for a killed centered random walk of finite variance. This yields the aforementioned asymptotics and should also be applicable to other models.}
}

