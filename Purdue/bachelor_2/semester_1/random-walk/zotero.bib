@article{gonzalezAsymptoticMoments2022,
  title = {Asymptotic Moments of Spatial Branching Processes},
  author = {Gonzalez, Isaac and Horton, Emma and Kyprianou, Andreas E.},
  date = {2022-12-01},
  journaltitle = {Probability Theory and Related Fields},
  shortjournal = {Probab. Theory Relat. Fields},
  volume = {184},
  number = {3},
  pages = {805--858},
  issn = {1432-2064},
  doi = {10.1007/s00440-022-01131-2},
  abstract = {Suppose that \$\$X =(X\_t, t\textbackslash ge 0)\$\$is either a superprocess or a branching Markov process on a general space E, with non-local branching mechanism and probabilities \$\$\{\textbackslash mathbb \{P\}\}\_\{\textbackslash delta \_x\}\$\$, when issued from a unit mass at \$\$x\textbackslash in E\$\$. For a general setting in which the first moment semigroup of X displays a Perron--Frobenius type behaviour, we show that, for \$\$k\textbackslash ge 2\$\$and any positive bounded measurable function f on E, \$\$\textbackslash begin\{aligned\} \textbackslash lim \_\{t\textbackslash rightarrow \textbackslash infty \} g\_k(t)\{\textbackslash mathbb \{E\}\}\_\{\textbackslash delta \_x\}[\textbackslash langle f, X\_t\textbackslash rangle \textasciicircum k] = C\_k(x, f), \textbackslash end\{aligned\}\$\$limt{$\rightarrow\infty$}gk(t)E{$\delta$}x[{$\langle$}f,Xt{$\rangle$}k]=Ck(x,f),where the constant \$\$C\_k(x, f)\$\$can be identified in terms of the principal right eigenfunction and left eigenmeasure and \$\$g\_k(t)\$\$is an appropriate deterministic normalisation, which can be identified explicitly as either polynomial in t or exponential in t, depending on whether X is a critical, supercritical or subcritical process. The method we employ is extremely robust and we are able to extract similarly precise results that additionally give us the moment growth with time of \$\$\textbackslash int \_0\textasciicircum t \textbackslash langle f, X\_t \textbackslash rangle \textbackslash mathrm\{d\}s\$\$, for bounded measurable f on E.},
  langid = {english}
}

@article{grevenLargeDeviations1994,
  title = {Large {{Deviations}} for a {{Random Walk}} in {{Random Environment}}},
  author = {Greven, Andreas and Den Hollander, Frank},
  date = {1994-07-01},
  journaltitle = {The Annals of Probability},
  shortjournal = {Ann. Probab.},
  volume = {22},
  number = {3},
  issn = {0091-1798},
  doi = {10.1214/aop/1176988607},
  abstract = {Let \$\textbackslash omega = (p\_x)\_\{x\textbackslash in\textbackslash mathbb\{Z\}\}\$ be an i.i.d. collection of (0, 1)-valued random variables. Given \$\textbackslash omega\$, let \$(X\_n)\_\{n \textbackslash geq 0\}\$ be the Markov chain on \$\textbackslash mathbb\{Z\}\$ defined by \$X\_0 = 0\$ and \$X\_\{n + 1\} = X\_n + 1(\textbackslash operatorname\{resp\}. X\_n - 1)\$ with probability \$p\_\{X\_n\}(\textbackslash operatorname\{resp\}.1 - p\_\{X\_n\})\$. It is shown that \$X\_n/n\$ satisfies a large deviation principle with a continuous rate function, that is, \$\textbackslash lim\_\{n\textbackslash rightarrow\textbackslash infty\}\textbackslash frac\{1\}\{n\}\textbackslash log P\_\textbackslash omega(X\_n = \textbackslash lfloor\textbackslash theta\_nn\textbackslash rfloor) = -I(\textbackslash theta) \textbackslash omega-\textbackslash mathrm\{a.s.\}\textbackslash text\{for\} \textbackslash theta\_n\textbackslash rightarrow\textbackslash in\textbackslash lbrack -1, 1\textbackslash rbrack.\$ First, we derive a representation of the rate function \$I\$ in terms of a variational problem. Second, we solve the latter explicitly in terms of random continued fractions. This leads to a classification and qualitative description of the shape of \$I\$. In the recurrent case \$I\$ is nonanalytic at \$\textbackslash theta = 0\$. In the transient case \$I\$ is nonanalytic at \$\textbackslash theta = -\textbackslash theta\_c, 0, \textbackslash theta\_c\$ for some \$\textbackslash theta\_c \textbackslash geq 0\$, with linear pieces in between.}
}

@online{hongStochasticPartial2024,
  title = {Stochastic Partial Differential Equations for Superprocesses in Random Environments},
  author = {Hong, Jieliang and Xiong, Jie},
  date = {2024-03-08},
  eprint = {2403.03638},
  eprinttype = {arXiv},
  eprintclass = {math},
  doi = {10.48550/arXiv.2403.03638},
  abstract = {Let \$X=(X\_t, t\textbackslash geq 0)\$ be a superprocess in a random environment described by a Gaussian noise \$W\textasciicircum g=\textbackslash\{W\textasciicircum g(t,x), t\textbackslash geq 0, x\textbackslash in \textbackslash mathbb\{R\}\textasciicircum d\textbackslash\}\$ white in time and colored in space with correlation kernel \$g(x,y)\$. We show that when \$d=1\$, \$X\_t\$ admits a jointly continuous density function \$X\_t(x)\$ that is a unique in law solution to a stochastic partial differential equation \textbackslash begin\{align*\} \textbackslash frac\{\textbackslash partial \}\{\textbackslash partial t\}X\_t(x)=\textbackslash frac\{\textbackslash Delta\}\{2\} X\_t(x)+\textbackslash sqrt\{X\_t(x)\} \textbackslash dot\{V\}(t,x)+X\_t(x)\textbackslash dot\{W\}\textasciicircum g(t, x) , \textbackslash quad X\_t(x)\textbackslash geq 0, \textbackslash end\{align*\} where \$V=\textbackslash\{V(t,x), t\textbackslash geq 0, x\textbackslash in \textbackslash mathbb\{R\}\textbackslash\}\$ is a space-time white noise and is orthogonal with \$W\textasciicircum g\$. When \$d\textbackslash geq 2\$, we prove that \$X\_t\$ is singular and hence density does not exist.},
  langid = {english},
  pubstate = {prepublished}
}

@online{huMeanfieldSuperBrownian2022,
  title = {On Mean-Field Super-{{Brownian}} Motions},
  author = {Hu, Yaozhong and Kouritzin, Michael A. and Xia, Panqiu and Zheng, Jiayu},
  date = {2022-12-11},
  eprint = {2111.11233},
  eprinttype = {arXiv},
  eprintclass = {math},
  doi = {10.48550/arXiv.2111.11233},
  abstract = {The mean-field stochastic partial differential equation (SPDE) corresponding to a mean-field super-Brownian motion (sBm) is obtained and studied. In this mean-field sBm, the branching-particle lifetime is allowed to depend upon the probability distribution of the sBm itself, producing an SPDE whose space-time white noise coefficient has, in addition to the typical sBm square root, an extra factor that is a function of the probability law of the density of the mean-field sBm. This novel mean-field SPDE is thus motivated by population models where things like overcrowding and isolation can affect growth. A two step approximation method is employed to show existence for this SPDE under general conditions. Then, mild moment conditions are imposed to get uniqueness. Finally, smoothness of the SPDE solution is established under a further simplifying condition.},
  pubstate = {prepublished}
}

@article{hushiMinimalPosition2009,
  title = {Minimal Position and Critical Martingale Convergence in Branching Random Walks, and Directed Polymers on Disordered Trees},
  author = {Hu, Yueyun and Shi, Zhan},
  date = {2009-03},
  journaltitle = {The Annals of Probability},
  volume = {37},
  number = {2},
  pages = {742--789},
  publisher = {Institute of Mathematical Statistics},
  issn = {0091-1798, 2168-894X},
  doi = {10.1214/08-AOP419},
  abstract = {We establish a second-order almost sure limit theorem for the minimal position in a one-dimensional super-critical branching random walk, and also prove a martingale convergence theorem which answers a question of Biggins and Kyprianou [Electron. J. Probab. 10 (2005) 609--631]. Our method applies, furthermore, to the study of directed polymers on a disordered tree. In particular, we give a rigorous proof of a phase transition phenomenon for the partition function (from the point of view of convergence in probability), already described by Derrida and Spohn [J. Statist. Phys. 51 (1988) 817--840]. Surprisingly, this phase transition phenomenon disappears in the sense of upper almost sure limits.}
}

