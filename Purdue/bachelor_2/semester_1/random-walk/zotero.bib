@article{ait-sahaliaTestingJumpsDiscretely2009,
  title = {Testing for Jumps in a Discretely Observed Process},
  author = {A\"it-Sahalia, Yacine and Jacod, Jean},
  date = {2009-02-01},
  journaltitle = {The Annals of Statistics},
  shortjournal = {Ann. Statist.},
  volume = {37},
