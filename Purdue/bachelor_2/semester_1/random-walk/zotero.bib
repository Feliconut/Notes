@online{lodhiaFractionalGaussian2016,
  title = {Fractional {{Gaussian}} Fields: A Survey},
  shorttitle = {Fractional {{Gaussian}} Fields},
  author = {Lodhia, Asad and Sheffield, Scott and Sun, Xin and Watson, Samuel S.},
  date = {2016-02-05},
  eprint = {1407.5598},
  eprinttype = {arxiv},
  eprintclass = {math},
  url = {http://arxiv.org/abs/1407.5598},
  urldate = {2023-06-26},
  abstract = {We discuss a family of random fields indexed by a parameter \$s\textbackslash in \textbackslash mathbb\{R\}\$ which we call the fractional Gaussian fields, given by \textbackslash [ \textbackslash mathrm\{FGF\}\_s(\textbackslash mathbb\{R\}\^d)=(-\textbackslash Delta)\^\{-s/2\} W, \textbackslash ] where \$W\$ is a white noise on \$\textbackslash mathbb\{R\}\^d\$ and \$(-\textbackslash Delta)\^\{-s/2\}\$ is the fractional Laplacian. These fields can also be parameterized by their Hurst parameter \$H = s-d/2\$. In one dimension, examples of \$\textbackslash mathrm\{FGF\}\_s\$ processes include Brownian motion (\$s = 1\$) and fractional Brownian motion (\$1/2 {$<$} s {$<$} 3/2\$). Examples in arbitrary dimension include white noise (\$s = 0\$), the Gaussian free field (\$s = 1\$), the bi-Laplacian Gaussian field (\$s = 2\$), the log-correlated Gaussian field (\$s = d/2\$), L\textbackslash 'evy's Brownian motion (\$s = d/2 + 1/2\$), and multidimensional fractional Brownian motion (\$d/2 {$<$} s {$<$} d/2 + 1\$). These fields have applications to statistical physics, early-universe cosmology, finance, quantum field theory, image processing, and other disciplines. We present an overview of fractional Gaussian fields including covariance formulas, Gibbs properties, spherical coordinate decompositions, restrictions to linear subspaces, local set theorems, and other basic results. We also define a discrete fractional Gaussian field and explain how the \$\textbackslash mathrm\{FGF\}\_s\$ with \$s \textbackslash in (0,1)\$ can be understood as a long range Gaussian free field in which the potential theory of Brownian motion is replaced by that of an isotropic \$2s\$-stable L\textbackslash 'evy process.},
  pubstate = {preprint}
}

