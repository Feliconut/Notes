@article{sohnCostsReproduction1977,
  title = {The {{Costs}} of {{Reproduction}} in the {{Mayapple Podophyllum Peltatum}} ({{Berberidaceae}})},
  author = {Sohn, J. and Policansky, D.},
  date = {1977-11},
  doi = {10.2307/1935088},
  abstract = {The mayapple, Podophyllum peltatum (L.), is an herbaceous, rhizomatous perennial growing in the deciduous woods of the eastern USA. It is possible, by examination of the rhizome, to determine the incidence of sexual or asexual reprdocution in previous seasons. We deomonstrate that a good predictor of sexuality is the size of the preceding internode. We show that the probability of being sexual in the future decreases if the mayapples successfully bears fruit, and that there is a decrease in future survivorship. The results of observations and experiments lead us to the conclusion that the probability of current and future sexual reproduction is bein maximized, and not the umber of aerial shoots.}
}

