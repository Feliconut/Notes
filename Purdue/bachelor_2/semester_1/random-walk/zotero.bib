@article{voorneveldKKMSperner2017,
  title = {An Elementary Direct Proof That the {{Knaster-Kuratowski-Mazurkiewicz}} Lemma Implies {{Sperner}}'s Lemma},
  author = {Voorneveld, Mark},
  date = {2017-09},
  journaltitle = {Economics Letters},
  shortjournal = {Economics Letters},
  volume = {158},
  eprint = {1706.06740},
  eprinttype = {arXiv},
  eprintclass = {math},
  pages = {1--2},
  issn = {01651765},
  doi = {10.1016/j.econlet.2017.06.013},
  abstract = {Three central results in economic theory --- Brouwer's fixed-point theorem, Sperner's lemma, and the Knaster-Kuratowski-Mazurkiewicz (KKM) lemma --- are known to be equivalent. In almost all cases, elementary direct proofs of one of these results using any of the others are easily found in the literature. This seems not to be the case for the claim that the KKM lemma implies Sperner's lemma. The goal of this note is to provide such a proof.}
}

