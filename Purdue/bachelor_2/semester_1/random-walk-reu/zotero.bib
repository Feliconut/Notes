@online{kosyginaConvergenceNonconvergenceScaled2022,
  title = {Convergence and Non-Convergence of Scaled Self-Interacting Random Walks to {{Brownian}} Motion Perturbed at Extrema},
  author = {Kosygina, Elena and Mountford, Thomas and Peterson, Jonathon},
  date = {2022-08-04},
  eprint = {2208.02589},
  eprinttype = {arxiv},
  eprintclass = {math},
  doi = {10.48550/arXiv.2208.02589},
  url = {http://arxiv.org/abs/2208.02589},
  urldate = {2023-03-20},
  abstract = {We use generalized Ray-Knight theorems introduced by B\textbackslash 'alint T\textbackslash 'oth in 1996 together with techniques developed for excited random walks as main tools for establishing positive and negative results concerning convergence of some classes of diffusively scaled self-interacting random walks (SIRWs) to Brownian motions perturbed at extrema (BMPE). T\textbackslash 'oth's work studied two classes of SIRWs: asymptotically free and polynomially self-repelling walks. For both classes Toth has shown, in particular, that the distribution function of a scaled SIRW observed at independent geometric times converges to that of a BMPE indicated by the generalized Ray-Knight theorem for this SIRW. The question of weak convergence of one-dimensional distributions of scaled SIRW remained open. In this paper, on the one hand, we prove a full functional limit theorem for a large class of asymptotically free SIRWs which includes asymptotically free walks considered in T\textbackslash 'oth's paper. On the other hand, we show that rescaled polynomially self-repelling SIRWs do not converge to the BMPE predicted by the corresponding generalized Ray-Knight theorems and, hence, do not converge to any BMPE.},
  pubstate = {preprint},
  keywords = {⛔ No DOI found,60K35,fully-read,important,Mathematics - Probability,reading},
  file = {/Users/xiaoyu/Library/CloudStorage/OneDrive-Personal/Zotero-PC/Kosygina et al_2022_Convergence and non-convergence of scaled self-interacting random walks to.pdf;/Users/xiaoyu/Zotero/storage/5NU3CARR/2208.html}
}

