@unpublished{nutiSecretaryProblemsPower2022,
  title = {Secretary {{Problems}}: {{The Power}} of a {{Single Sample}}},
  shorttitle = {Secretary {{Problems}}},
  author = {Nuti, Pranav and Vondr\'ak, Jan},
  date = {2022-08-19},
  eprint = {2208.09159},
  eprinttype = {arXiv},
  eprintclass = {cs, math},
  publisher = {arXiv},
  url = {http://arxiv.org/abs/2208.09159},
  urldate = {2022-08-22},
  abstract = {In this paper, we investigate two variants of the secretary problem. In these variants, we are presented with a sequence of numbers \$X\_i\$ that come from distributions \$\textbackslash mathcal\{D\}\_i\$, and that arrive in either random or adversarial order. We do not know what the distributions are, but we have access to a single sample \$Y\_i\$ from each distribution \$\textbackslash mathcal\{D\}\_i\$. After observing each number, we have to make an irrevocable decision about whether we would like to accept it or not with the goal of maximizing the probability of selecting the largest number. The random order version of this problem was first studied by Correa et al. [SODA 2020] who managed to construct an algorithm that achieves a probability of \$0.4529\$. In this paper, we improve this probability to \$0.5009\$, almost matching an upper bound of \$\textbackslash simeq 0.5024\$ which we show follows from earlier work. We also show that there is an algorithm which achieves the probability of \$\textbackslash simeq 0.5024\$ asymptotically if no particular distribution is especially likely to yield the largest number. For the adversarial order version of the problem, we show that we can select the maximum number with a probability of \$1/4\$, and that this is best possible. Our work demonstrates that unlike in the case of the expected value objective studied by Rubinstein et al. [ITCS 2020], knowledge of a single sample is not enough to recover the factor of success guaranteed by full knowledge of the distribution.}
}

@unpublished{pinskySecretaryProblemBiased2021a,
  title = {The Secretary Problem with Biased Arrival Order via a {{Mallows}} Distribution},
  author = {Pinsky, Ross G.},
  date = {2021-11-30},
  eprint = {2111.00567},
  eprinttype = {arXiv},
  eprintclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2111.00567},
  url = {http://arxiv.org/abs/2111.00567},
  urldate = {2022-05-28},
  abstract = {We solve the secretary problem in the case that the ranked items arrive in a statistically biased order rather than in uniformly random order. The bias is given by a Mallows distribution with parameter \$q\textbackslash in(0,1)\$, so that higher ranked items tend to arrive later and lower ranked items tend to arrive sooner. In the classical problem, the asymptotically optimal strategy is to reject the first \$M\_n\textasciicircum *\$ items, where \$M\_n\textasciicircum *\textbackslash sim\textbackslash frac ne\$, and then to select the first item ranked higher than any of the first \$M\_n\textasciicircum *\$ items (if such an item exists). This yields \$\textbackslash frac1e\$ as the limiting probability of success. The Mallows distribution with parameter \$q=1\$ is the uniform distribution. For the regime \$q\_n=1-\textbackslash frac cn\$, with \$c{$>$}0\$, the case of weak bias, the optimal strategy occurs with \$M\_n\textasciicircum *\textbackslash sim n\textbackslash Big(\textbackslash frac1c\textbackslash log\textbackslash big(1+\textbackslash frac\{e\textasciicircum c-1\}e\textbackslash big)\textbackslash Big)\$, with the limiting probability of success being \$\textbackslash frac1e\$. For the regime \$q\_n=1-\textbackslash frac c\{n\textasciicircum\textbackslash alpha\}\$, with \$c{$>$}0\$ and \$\textbackslash alpha\textbackslash in(0,1)\$, the case of moderate bias, the optimal strategy occurs with \$n-M\_n\textbackslash sim\textbackslash frac\{n\textasciicircum\textbackslash alpha\}c\$, with the limiting probability of success being \$\textbackslash frac1e\$. For fixed \$q\textbackslash in(0,1)\$, the case of strong bias, the optimal strategy occurs with \$M\_n\textasciicircum *=n-L\$ where \$\textbackslash frac\{L-1\}L{$<$}q\textbackslash le \textbackslash frac L\{L+1\}\$, with limiting probability of success being \$(1-q)q\textasciicircum\{L-1\}L{$>\backslash$}frac1e\$.}
}

@unpublished{pinskySecretaryProblemMultiple2022,
  title = {The {{Secretary Problem}} with Multiple Items at Each Rank},
  author = {Pinsky, Ross G.},
  date = {2022-04-06},
  eprint = {2204.01610},
  eprinttype = {arXiv},
  eprintclass = {math},
  url = {http://arxiv.org/abs/2204.01610},
  urldate = {2022-05-28},
  abstract = {For \$k\textbackslash ge2\$, consider the following variation of the classical secretary problem. There are \$k\$ items at each of \$n\$ ranks. The \$kn\$ items are revealed, one by one in a uniformly random order, to an observer whose objective is to select an item with the highest rank. At each stage the observer only knows the relative ranks of the items that have arrived thus far, and must either select the current item, or reject it and continue to the next item. Let \$\textbackslash mathcal\{S\}(n,k;M)\$ denote the strategy whereby one allows the first \$M\$ items to pass, and then chooses the first later arriving item whose rank is either equal to or greater than the highest rank of the first \$M\$ items (if such an item exists). Let \$P\_\{n,k\}(\textbackslash mathcal\{S\}(n,k;M))\$ denote the probability of selecting an item of highest rank using strategy \$\textbackslash mathcal\{S\}(n,k;M)\$. We obtain a formula for \$P\_\{n,k\}(\textbackslash mathcal\{S\}(n,k;M))\$, and a formula for \$\textbackslash lim\_\{n\textbackslash to\textbackslash infty\}P\_\{n,k\}(\textbackslash mathcal\{S\}(n,k,M\_n))\$, when \$M\_n\textbackslash sim ckn\$, with \$c\textbackslash in(0,1)\$. In the classical secretary problem, the asymptotically optimal strategy \$M\_n\textbackslash sim cn\$ occurs with \$c=\textbackslash frac1e\textbackslash approx0.368\$, and the corresponding asymptotic probability of success is \$\textbackslash frac1e\textbackslash approx 0.368\$. For \$k=2\$, the asymptotically optimal strategy \$M\_n\textbackslash sim ckn\$ occurs with \$c\textbackslash approx 0.368\$ -- almost exactly the same \$c\$ as in the classical case, and the corresponding asymptotic probability of success jumps dramatically to 0.701. For \$k=10\$, the optimal probability is above 0.999. The optimal value of \$c\$ stabilizes around 0.486 for \$n\textbackslash ge20\$. We also consider the strategies \$\textbackslash mathcal\{S\}\textasciicircum +(n,k;M)\$, whereby one allows the first \$M\$ items to pass, and then chooses the first later arriving item whose rank is strictly greater than the highest rank of the first \$M\$ items (if such an item exists). These strategies turn the problem into one that is essentially equivalent to the classical secretary problem.},
  pubstate = {prepublished}
}

@unpublished{pinskySecretaryProblemNonuniform2022,
  title = {The Secretary Problem with Non-Uniform Arrivals via a Left-to-Right-Minimum Exponentially Tilted Distribution},
  author = {Pinsky, Ross G.},
  date = {2022-05-25},
  eprint = {2112.07930},
  eprinttype = {arXiv},
  eprintclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2112.07930},
  url = {http://arxiv.org/abs/2112.07930},
  urldate = {2022-05-28},
  abstract = {We solve the secretary problem in the case that the ranked items arrive in a statistically biased order rather than in uniformly random order. The bias is given by the left-to-right-minimum exponentially tilted distribution with parameter \$q\textbackslash in(0,\textbackslash infty)\$. That is, for \$\textbackslash sigma\textbackslash in S\_n\$, \$P\_n(\textbackslash sigma)\$ is proportional to \$q\textasciicircum\{\textbackslash text\{LR\}\textasciicircum\{-\}\_n(\textbackslash sigma)\}\$, where the left-to-right minimum statistic \$\textbackslash text\{LR\}\textasciicircum -\_n\$ is defined by \$\$ \textbackslash text\{LR\}\textasciicircum\{-\}\_n(\textbackslash sigma)=\textbar\textbackslash\{j\textbackslash in[n]: \textbackslash sigma\_j=\textbackslash min\textbackslash\{\textbackslash sigma\_i:1\textbackslash le i\textbackslash le j\textbackslash\}\textbackslash\}\textbar,\textbackslash{} \textbackslash sigma\textbackslash in S\_n. \$\$ For \$q\textbackslash in(0,1)\$, higher ranked items tend to arrive earlier than in the case of the uniform distribution, and for \$q\textbackslash in(1,\textbackslash infty)\$, they tend to arrive later. In the classical problem, the asymptotically optimal strategy is to reject the first \$M\_n\textasciicircum *\$ items, where \$M\_n\textasciicircum *\textbackslash sim\textbackslash frac ne\$, and then to select the first item ranked higher than any of the first \$M\_n\textasciicircum *\$ items (if such an item exists). This yields \$e\textasciicircum\{-1\}\$ as the limiting probability of success. With the above bias on arrivals, we calculate the asymptotic behavior of the optimal strategy \$M\_n\textasciicircum *\$ and the corresponding limiting probability of success, for all regimes of \$\textbackslash\{q\_n\textbackslash\}\_\{n=1\}\textasciicircum\textbackslash infty\$. In particular, if the leading order asymptotic behavior of \$\textbackslash\{q\_n\textbackslash\}\_\{n=1\}\textasciicircum\textbackslash infty\$ is at least \$\textbackslash frac1\{\textbackslash log n\}\$, and if also its order is no more than \$o(n)\$, then the limiting probability of success when using an asymptotically optimal strategy is \$e\textasciicircum\{-1\}\$; otherwise, this limiting probability of success is greater than \$e\textasciicircum\{-1\}\$. Also, the limiting fraction of numbers, \$\textbackslash lim\_\{n\textbackslash to\textbackslash infty\}\textbackslash frac\{M\textasciicircum *\_n\}n\$, that are summarily rejected by an asymptotically optimal strategy lies in \$(0,1)\$ if and only if \$\textbackslash lim\_\{n\textbackslash to\textbackslash infty\}q\_n\textbackslash in(0,\textbackslash infty)\$.}
}

