\begin{problem}
	(Tikhonov's example) Let
\[
g(t):= \begin{cases}\exp \left(-t^{-2}\right), & t>0 \\ 0, & t \leq 0\end{cases}
\]

Then $g \in C^{\infty}(\mathbb{R})$ and we define
\[
u(x, t):=\sum_{k=0}^{\infty} \frac{g^{(k)}(t)}{(2 k) !} x^{2 k} .
\]
(a) Given that the derivatives of $g$ satisfy [you don't have to prove it]
\[
\left|g^{(k)}(t)\right| \leq \frac{k !}{(\theta t)^k} \exp \left(-\frac{1}{2} t^{-2}\right), \quad t>0, k=0,1, \ldots,
\]
for some $\theta>0$, show that the series for $u$ converges locally uniformly in $\mathbb{R}^2$.\\
(b) Show that you can differentiate $u(x, t)$ by differentiating its series term-by-term both in $x$ and $t$ variables, for arbitrary number of times; particularly, $u \in C^{\infty}\left(\mathbb{R}^2\right)$. Show, however, that $u$ is not real analytic.\\
(c) Show that $u(x, t)$ solves the heat equation in $\mathbb{R} \times(0, \infty)$ with the initial condition $u(x, 0)=$ $0, x \in \mathbb{R}$. Why doesn't this contradict the uniqueness theorem for the initial value problem?
\end{problem}
\begin{proof}
	(a) Note that $t^{- k} \exp\left( - \frac{1}{2}t^{-2} \right) $ is bounded in $t$ for any $k$.
	In any bounded open subset $U \subset \mathbb{R}^2$, we have
	\[
		u(x, t) \le \sum_{k=0}^{\infty} \frac{\|g^{(k)}(t)\|_{L^\infty (U)}}{(2k)!} \|x\|_{L^\infty (U)}^{2k}
		\le \sum_{k=0}^{\infty} \frac{k! M_1}{\theta^k (2 k)!} M_2^{2k} < \infty 
	.\] 

	(b) To justify termwise differentiation, we need to show that the derivative of partial sums converge uniformly. Denote partial sums by $u_n$. Differentiate in $x$, we get
	\begin{align*}
		D_x u_n(x,t) 
		&= \sum_{k=1}^{n} \frac{g^{(k)}(t)}{(2k-1)!}x^{2k-1} \\
		&= \sum_{k=1}^{n} \frac{k!}{(\theta t)^k(2k-1)!}\exp\left( - \frac{1}{2} t^{-2} \right)  x^{2k-1} \\
		&= \sum_{n=0}^{n-1} \frac{(k+1)!}{(\theta t)^{k+1} (2 k + 1)!} \exp\left( - \frac{1}{2} t^{-2} \right) x^{2 k + 1} \\
		&\leq x \sum_{n=0}^{n-1} \frac{1}{(\theta t)^{k+1} } \exp\left( - \frac{1}{2} t^{-2} \right) \frac{x^{2k}}{k!} \\
		&\leq C x e^{x^2} < \infty 
	.\end{align*} 
\end{proof}


