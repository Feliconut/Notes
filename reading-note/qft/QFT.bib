  date = {2019-09-04},
  abstract = {Spinor-helicity variables are introduced as solutions to the massless Dirac equation and are used as a tool for calculating several scattering amplitudes. The extension to the massive case is then examined and massless and massive variables are finally used to construct a UV completion of general relativity.},
