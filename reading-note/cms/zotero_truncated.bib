@article{fabbrichesiTestingBell2021,
  title = {Testing {{Bell}} Inequalities at the {{LHC}} with Top-Quark Pairs},
  author = {Fabbrichesi, M. and Floreanini, R. and Panizzo, G.},
  date = {2021-10-15},
  journaltitle = {Physical Review Letters},
  shortjournal = {Phys. Rev. Lett.},
  volume = {127},
  number = {16},
