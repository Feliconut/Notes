@article{horodeckiInformationtheoreticAspects1996,
  title = {Information-Theoretic Aspects of Inseparability of Mixed States},
  author = {Horodecki, Ryszard and Horodecki, Michal/},
  date = {1996-09-01},
  journaltitle = {Physical Review A},
  shortjournal = {Phys. Rev. A},
  volume = {54},
  number = {3},
  pages = {1838--1843},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevA.54.1838},
  abstract = {Information-theoretic aspects of quantum inseparability of mixed states are investigated in terms of the {$\alpha$} entropy inequalities and teleportation fidelity. Inseparability of mixed states is defined and a complete characterization of the inseparable 2\texttimes 2 systems with maximally disordered subsystems is presented within the Hilbert-Schmidt space formalism. A connection between teleportation and negative conditional {$\alpha$} entropy is also emphasized. \copyright{} 1996 The American Physical Society.}
}

@article{horodeckiQuantumEntanglement2009,
  title = {Quantum Entanglement},
  author = {Horodecki, Ryszard and Horodecki, Pawel and Horodecki, Michal and Horodecki, Karol},
  date = {2009-06-17},
  journaltitle = {Reviews of Modern Physics},
  shortjournal = {Rev. Mod. Phys.},
  volume = {81},
  number = {2},
  eprint = {quant-ph/0702225},
  eprinttype = {arXiv},
  pages = {865--942},
  issn = {0034-6861, 1539-0756},
  doi = {10.1103/RevModPhys.81.865},
  abstract = {All our former experience with application of quantum theory seems to say: \{\textbackslash it what is predicted by quantum formalism must occur in laboratory\}. But the essence of quantum formalism - entanglement, recognized by Einstein, Podolsky, Rosen and Schr\textbackslash "odinger - waited over 70 years to enter to laboratories as a new resource as real as energy. This holistic property of compound quantum systems, which involves nonclassical correlations between subsystems, is a potential for many quantum processes, including ``canonical'' ones: quantum cryptography, quantum teleportation and dense coding. However, it appeared that this new resource is very complex and difficult to detect. Being usually fragile to environment, it is robust against conceptual and mathematical tools, the task of which is to decipher its rich structure. This article reviews basic aspects of entanglement including its characterization, detection, distillation and quantifying. In particular, the authors discuss various manifestations of entanglement via Bell inequalities, entropic inequalities, entanglement witnesses, quantum cryptography and point out some interrelations. They also discuss a basic role of entanglement in quantum communication within distant labs paradigm and stress some peculiarities such as irreversibility of entanglement manipulations including its extremal form - bound entanglement phenomenon. A basic role of entanglement witnesses in detection of entanglement is emphasized.},
  langid = {english}
}

