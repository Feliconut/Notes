@article{aguilar-saavedraImprovedTests2022,
  title = {Improved Tests of Entanglement and {{Bell}} Inequalities with {{LHC}} Tops},
  author = {Aguilar-Saavedra, J. A. and Casas, J. A.},
  date = {2022-08-03},
  journaltitle = {The European Physical Journal C},
  shortjournal = {Eur. Phys. J. C},
  volume = {82},
  number = {8},
  eprint = {2205.00542},
  eprinttype = {arXiv},
  eprintclass = {hep-ph},
  pages = {666},
  issn = {1434-6052},
  doi = {10.1140/epjc/s10052-022-10630-4},
  abstract = {We discuss quantum entanglement in top pair production at the LHC. Near the tt\textasciimacron{} threshold, entanglement observables are enhanced by suppressing the contribution of qq\textasciimacron{} subprocesses, which is achieved by a simple cut on the velocity of the tt\textasciimacron{} system in the laboratory frame. Furthermore, we design new observables that directly measure the relevant combinations of tt\textasciimacron{} spin correlation coefficients involved in the measurement of entanglement and Bell inequalities. As a result, the statistical sensitivity is enhanced, up to a factor of 7 for Bell inequalities near threshold.},
  langid = {english}
}

@unpublished{AN-20-037,
  title = {Multi-Differential Measurement of the Spin Density Production Matrix in Ttbar Production and Decay Using the Full {{CMS Run}} 2 Data Set},
  shorttitle = {{{AN-20-037}}},
  author = {Thieman, Jason and Wildridge, Andrew and Jung, Andreas and Negro, Giulia and {Amandeep Bakshi} and {Abraham Mathew Koshy} and {Matthew Jones}},
  date = {2023-01-29},
  abstract = {Measurements of the top quark polarization and top quark pair (t\textasciimacron t) spin correlations are presented using events containing two leptons produced in proton-proton collisions at a centre-of-mass energy of 13 TeV. The data were recorded by the CMS experiment at the CERN LHC during 2016, 2017, and 2018 and correspond to the full Run II integrated luminosity of 137/fb. A set of multi-differential cross section distributions are measured corresponding to each of the independent coefficients of the top-spin dependent parts of the t\textasciimacron t production density matrix. All distributions are unfolded to particle and parton-level, and compared to standard model predictions from Monte Carlo simulations with next-to-leading-order (NLO) accuracy in quantum chromodynamics (QCD) at matrix-element level interfaced to parton-shower simulations. In the case of parton-level unfolded data results are also compared to fixed-order calculations at next-to-next-to-leading-order in QCD with electroweak corrections. The spin coefficients are extracted from the measured distributions and compared to values from fixed order calculations at NLO in QCD with electroweak corrections. The measurement provides a precision test of the standard model of particle physics and probes for deviations, which could be a sign of new physics.},
  howpublished = {CMS Draft Note},
  langid = {english},
  pagetotal = {385}
}

@unpublished{anuarObservationNew2025,
  title = {Observation of a New Structure Resembling Pseudoscalar Toponium at the Top Quark-Antiquark Pair Threshold},
  author = {Anuar, Afiq and Bach, Jorn and Baxter, Samuel and Grohsjean, Alexander and Jeppe, Laurids and Rubenach, Jonas and Schwanenberger, Christian and Knolle, Joscha},
  date = {2025-02-17},
  abstract = {A search for resonances in top quark pair (tt) production is presented using final states with two charged leptons and jets, based on 138 fb-1 of \textsurd s = 13 TeV proton- proton collision data collected by the CMS experiment at the CERN LHC. The analy- sis explores the invariant mass of the tt system and angular observables sensitive to the correlation of top quark and antiquark spins. A significant excess above the pre- diction from fixed-order perturbative quantum chromodynamics (pQCD) is observed near the kinematic tt production threshold. The observed structure is consistent with the production of a color-singlet pseudoscalar quasi-bound state, as predicted by non- relativistic quantum chromodynamics (NRQCD) in the form of a 1S[1] 0 toponium state. Using a simplified model for 1S[1] 0 toponium inspired by NRQCD, the cross section of the excess above the pQCD prediction is measured to be 8.8+1.2 -1.4 pb.},
  langid = {english}
}

